{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConfigureRecordingsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketPolicy",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::travel-search-recordings-481665099496-us-west-2"
    },
    {
      "Sid": "ConfigureLambdaRecordingUploads",
      "Effect": "Allow",
      "Action": "iam:PutRolePolicy",
      "Resource": "arn:aws:iam::481665099496:role/flight-search-service-lambda"
    }
  ]
}
