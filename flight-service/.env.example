# Local placeholders only. Set real values in the Lambda environment later.
# Set MongoDB values to store final search records. WebSocket delivery is a placeholder.
MONGODB_URI=replace_me
MONGODB_DATABASE=flight_service
MONGODB_SEARCH_COLLECTION=searches
WEBSOCKET_MANAGEMENT_ENDPOINT=replace_me
SKYVERN_API_KEY=replace_me
# Skyvern uses its default Cloud endpoint; no custom base URL needed.

# Final recording upload; leave the bucket blank to skip S3 storage.
RECORDINGS_S3_BUCKET=travel-search-recordings-481665099496-us-west-2
RECORDINGS_S3_REGION=us-west-2
RECORDING_WAIT_SECONDS=90
# TODO: add the backend POST receiver used by the frontend; blank skips delivery.
FLIGHT_RESULTS_POST_URL=
